# Copy this file to .env and adjust values for your environment.
# The application loads these values at startup (dotenv-java) and fails fast when required values are missing.

# JWT signing key (HMAC). Use a long random string.
SECRET_KEY=your_secret_key

# Stripe API secret key used to create Checkout Sessions.
# Get it from the Stripe Dashboard: Developers -> API keys.
STRIPE_SECRET_KEY=your_stripe_secret_key

# Stripe webhook signing secret used to verify webhook signatures.
# Get it from the Stripe Dashboard: Developers -> Webhooks -> (your endpoint) -> Signing secret.
# (Note: This is different from the secret generated by Stripe CLI "listen")
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# PostgreSQL connection info (used by application.yml).
DB_NAME=name
DB_USER=user
DB_PASSWORD=password

# Local port mapped to Postgres (docker-compose maps ${DB_PORT}:5432).
DB_PORT=5432